{
  "source": "App Builder - flow tests (retail-service, ngrok)",
  "requests": {
    "meta": {
      "name": "0.1 Form metadata",
      "method": "GET",
      "url": "{{baseUrl}}/app-builder/v1/meta"
    },
    "onboarding": {
      "name": "0b.3a Launch checklist",
      "method": "GET",
      "url": "{{baseUrl}}/app-builder/v1/onboarding?retailId={{retailId}}"
    },
    "updateOnboarding": {
      "name": "0b.3c Save checklist answers",
      "method": "PUT",
      "url": "{{baseUrl}}/app-builder/v1/onboarding",
      "body": {
        "mode": "raw",
        "raw": "{\n  \"retailId\": \"{{retailId}}\",\n  \"accountType\": \"ORGANIZATION\",\n  \"wantsAndroid\": true,\n  \"wantsIos\": true,\n  \"googleAccountCreated\": true,\n  \"appleAccountCreated\": true,\n  \"dunsNumber\": \"123456789\",\n  \"updatedBy\": \"{{userId}}\",\n  \"updatedByName\": \"{{userName}}\"\n}",
        "options": {
          "raw": {
            "language": "json"
          }
        }
      }
    },
    "connectGooglePlay": {
      "name": "0b.6 Connect Google Play (invite Pallet account)",
      "method": "POST",
      "url": "{{baseUrl}}/app-builder/v1/store-accounts/GOOGLE_PLAY?retailId={{retailId}}&developerAccountId=4726473283492637482&invitedConfirmed=true&updatedBy={{userId}}&updatedByName={{userName}}"
    },
    "storeAccounts": {
      "name": "0b.7 Store account status",
      "method": "GET",
      "url": "{{baseUrl}}/app-builder/v1/store-accounts?retailId={{retailId}}"
    },
    "createApp": {
      "name": "1.1 Create app",
      "method": "POST",
      "url": "{{baseUrl}}/app-builder/v1/apps",
      "body": {
        "mode": "raw",
        "raw": "{\n  \"retailId\": \"{{retailId}}\",\n  \"defaultBranchId\": \"{{branchId}}\",\n  \"appName\": \"Demo Store\",\n  \"merchantKey\": \"{{merchantKey}}\",\n  \"createdBy\": \"{{userId}}\",\n  \"createdByName\": \"{{userName}}\"\n}",
        "options": {
          "raw": {
            "language": "json"
          }
        }
      }
    },
    "getApp": {
      "name": "1.5 Get app",
      "method": "GET",
      "url": "{{baseUrl}}/app-builder/v1/apps/{{appId}}"
    },
    "listApps": {
      "name": "1.6 List apps of the retail",
      "method": "GET",
      "url": "{{baseUrl}}/app-builder/v1/apps?retailId={{retailId}}"
    },
    "updateApp": {
      "name": "1.7 Update app",
      "method": "PUT",
      "url": "{{baseUrl}}/app-builder/v1/apps/{{appId}}",
      "body": {
        "mode": "raw",
        "raw": "{\n  \"appName\": \"Demo Mart\",\n  \"signingProfile\": \"demo-signing\",\n  \"updatedBy\": \"{{userId}}\",\n  \"updatedByName\": \"{{userName}}\"\n}",
        "options": {
          "raw": {
            "language": "json"
          }
        }
      }
    },
    "defaultTheme": {
      "name": "2.1 Default theme",
      "method": "GET",
      "url": "{{baseUrl}}/app-builder/v1/theme/default"
    },
    "saveTheme": {
      "name": "2.6 Save theme (draft)",
      "method": "PUT",
      "url": "{{baseUrl}}/app-builder/v1/apps/{{appId}}/theme",
      "body": {
        "mode": "raw",
        "raw": "{\n  \"theme\": {\n    \"colors\": {\n      \"brand\": \"{{brandColor}}\",\n      \"accent\": \"#1E88E5\"\n    },\n    \"radii\": {\n      \"md\": 10\n    },\n    \"components\": {\n      \"button\": {\n        \"radius\": 8,\n        \"minHeight\": 44\n      }\n    }\n  },\n  \"updatedBy\": \"{{userId}}\",\n  \"updatedByName\": \"{{userName}}\"\n}",
        "options": {
          "raw": {
            "language": "json"
          }
        }
      }
    },
    "publishTheme": {
      "name": "2.7 Publish theme",
      "method": "POST",
      "url": "{{baseUrl}}/app-builder/v1/apps/{{appId}}/theme/publish",
      "body": {
        "mode": "raw",
        "raw": "{\n  \"updatedBy\": \"{{userId}}\",\n  \"updatedByName\": \"{{userName}}\"\n}",
        "options": {
          "raw": {
            "language": "json"
          }
        }
      }
    },
    "uploadAsset": {
      "name": "3.4 Upload icon (2048 JPEG, resized to 1024 PNG)",
      "method": "POST",
      "url": "{{baseUrl}}/app-builder/v1/apps/{{appId}}/assets/ICON",
      "body": {
        "mode": "formdata",
        "formdata": [
          {
            "key": "file",
            "type": "file"
          },
          {
            "key": "updatedBy",
            "value": "{{userId}}",
            "type": "text"
          },
          {
            "key": "updatedByName",
            "value": "{{userName}}",
            "type": "text"
          }
        ]
      }
    },
    "createBuild": {
      "name": "4.1 Publish (create build)",
      "method": "POST",
      "url": "{{baseUrl}}/app-builder/v1/apps/{{appId}}/builds",
      "body": {
        "mode": "raw",
        "raw": "{\n  \"platform\": \"ANDROID\",\n  \"environment\": \"STAGE\",\n  \"artifactType\": \"AAB\",\n  \"versionName\": \"1.0.0\",\n  \"createdBy\": \"{{userId}}\",\n  \"createdByName\": \"{{userName}}\"\n}",
        "options": {
          "raw": {
            "language": "json"
          }
        }
      }
    },
    "launchQueue": {
      "name": "4.1s2 Launch queue lists the Google invite",
      "method": "GET",
      "url": "{{baseUrl}}/app-builder/v1/launch/queue",
      "auth": {
        "type": "apikey",
        "apikey": [
          {
            "key": "key",
            "value": "X-App-Builder-Staff-Token",
            "type": "string"
          },
          {
            "key": "value",
            "value": "{{staffToken}}",
            "type": "string"
          },
          {
            "key": "in",
            "value": "header",
            "type": "string"
          }
        ]
      }
    },
    "launchProblem": {
      "name": "4.1s3 Staff reports a problem",
      "method": "POST",
      "url": "{{baseUrl}}/app-builder/v1/launch/store-accounts/GOOGLE_PLAY/problem?retailId={{retailId}}&reason=Invite not received. Please invite again with the Admin role.&staffUser=launch.team",
      "auth": {
        "type": "apikey",
        "apikey": [
          {
            "key": "key",
            "value": "X-App-Builder-Staff-Token",
            "type": "string"
          },
          {
            "key": "value",
            "value": "{{staffToken}}",
            "type": "string"
          },
          {
            "key": "in",
            "value": "header",
            "type": "string"
          }
        ]
      }
    },
    "launchConfirm": {
      "name": "4.1s6 Staff confirms access",
      "method": "POST",
      "url": "{{baseUrl}}/app-builder/v1/launch/store-accounts/GOOGLE_PLAY/confirm?retailId={{retailId}}&staffUser=launch.team",
      "auth": {
        "type": "apikey",
        "apikey": [
          {
            "key": "key",
            "value": "X-App-Builder-Staff-Token",
            "type": "string"
          },
          {
            "key": "value",
            "value": "{{staffToken}}",
            "type": "string"
          },
          {
            "key": "in",
            "value": "header",
            "type": "string"
          }
        ]
      }
    },
    "storeAccess": {
      "name": "4.1b Check store access for the app (Android)",
      "method": "GET",
      "url": "{{baseUrl}}/app-builder/v1/apps/{{appId}}/store-access?platform=ANDROID"
    },
    "getBuild": {
      "name": "4.6 Get build",
      "method": "GET",
      "url": "{{baseUrl}}/app-builder/v1/builds/{{buildId}}"
    },
    "appBuilds": {
      "name": "4.7 Build history of the app",
      "method": "GET",
      "url": "{{baseUrl}}/app-builder/v1/apps/{{appId}}/builds?page=0&size=20"
    },
    "dashboard": {
      "name": "4.8 Builds dashboard (all apps of the retail)",
      "method": "GET",
      "url": "{{baseUrl}}/app-builder/v1/builds?retailId={{retailId}}&status=&environment=&platform=&search=&page=0&size=20"
    },
    "retryDispatch": {
      "name": "4.10 Retry GitHub trigger",
      "method": "POST",
      "url": "{{baseUrl}}/app-builder/v1/builds/{{buildId}}/dispatch"
    },
    "ciConfig": {
      "name": "5.2 Get build config",
      "method": "GET",
      "url": "{{baseUrl}}/app-builder/ci/v1/builds/{{buildId}}/config"
    },
    "ciStatus": {
      "name": "5.5 Report SUCCESS",
      "method": "POST",
      "url": "{{baseUrl}}/app-builder/ci/v1/builds/{{buildId}}/status",
      "body": {
        "mode": "raw",
        "raw": "{\n  \"status\": \"SUCCESS\",\n  \"artifactUrl\": \"https://storage.googleapis.com/twinleaves_dev_public/app-builder/builds/{{buildId}}/app-release.aab\",\n  \"message\": \"Build finished\"\n}",
        "options": {
          "raw": {
            "language": "json"
          }
        }
      }
    },
    "connectAppleInvite": {
      "name": "5b.0e Invite Pallet to Apple (recommended)",
      "method": "POST",
      "url": "{{baseUrl}}/app-builder/v1/store-accounts/APPLE/invite?retailId={{retailId}}&teamId=ABCDE12345&invitedConfirmed=true&updatedBy={{userId}}&updatedByName={{userName}}"
    },
    "connectApple": {
      "name": "5b.1 Connect Apple",
      "method": "POST",
      "url": "{{baseUrl}}/app-builder/v1/store-accounts/APPLE",
      "body": {
        "mode": "formdata",
        "formdata": [
          {
            "key": "retailId",
            "value": "{{retailId}}",
            "type": "text"
          },
          {
            "key": "keyId",
            "value": "TEST123456",
            "type": "text"
          },
          {
            "key": "issuerId",
            "value": "57246542-96fe-1a63-e053-0824d011072a",
            "type": "text"
          },
          {
            "key": "privateKey",
            "type": "file"
          },
          {
            "key": "teamId",
            "value": "ABCDE12345",
            "type": "text"
          },
          {
            "key": "updatedBy",
            "value": "{{userId}}",
            "type": "text"
          },
          {
            "key": "updatedByName",
            "value": "{{userName}}",
            "type": "text"
          }
        ]
      }
    },
    "reverifyStore": {
      "name": "5b.4 Verify Apple again (from the stored key)",
      "method": "POST",
      "url": "{{baseUrl}}/app-builder/v1/store-accounts/APPLE/verify?retailId={{retailId}}&updatedBy={{userId}}"
    },
    "disconnectStore": {
      "name": "5b.5 Disconnect Google Play",
      "method": "DELETE",
      "url": "{{baseUrl}}/app-builder/v1/store-accounts/GOOGLE_PLAY?retailId={{retailId}}&updatedBy={{userId}}"
    },
    "deleteApp": {
      "name": "6.5 Delete app",
      "method": "DELETE",
      "url": "{{baseUrl}}/app-builder/v1/apps/{{appId}}?updatedBy={{userId}}&updatedByName={{userName}}"
    }
  }
}
