# The UI uses retail-service by default. Use demo to preview without a backend.
# Vite dev proxy avoids backend CORS restrictions on localhost.
VITE_DEV_PROXY=true
VITE_APP_BUILDER_MODE=real
VITE_API_BASE=https://17e1-202-83-17-69.ngrok-free.app/retail-service

# User-service login access token, sent in the Postman collection's `at` header.
# Local POC only. In RMS, inject its current authenticated user's token/context.
VITE_ACCESS_TOKEN=
VITE_RETAIL_ID=RET_421
VITE_BRANCH_ID=RLC_1316
VITE_USER_ID=dinesh
VITE_USER_NAME=Dinesh

# Internal clients only; never expose staff or CI controls in the merchant UI.
VITE_CI_TOKEN=
VITE_STAFF_TOKEN=
