# Copy to .env.local and adjust.
# retail-service base URL, including the /retail-service context path.
VITE_API_BASE=http://localhost:8081/retail-service

# Local testing only: same value as APP_BUILDER_CI_TOKEN on retail-service.
# Enables the "act as GitHub Actions" buttons on the build details screen.
# Leave empty in any deployed build.
VITE_CI_TOKEN=local-ci-token

# Local testing only: same value as APP_BUILDER_STAFF_TOKEN on retail-service.
# Shows the Launch Console (Pallet staff) page. In production the Launch Console
# belongs in Pallet's internal admin behind staff login; leave this empty.
VITE_STAFF_TOKEN=local-staff-token
